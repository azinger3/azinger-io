# OS / editor
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
*.swp
*~

# Logs
**/log/*
!**/log/.keep
*.log

# Temp files and caches
**/tmp/*
!**/tmp/.keep
!**/tmp/pids/
**/tmp/pids/*
!**/tmp/pids/.keep
!**/tmp/storage/
**/tmp/storage/*
!**/tmp/storage/.keep

# Local storage (SQLite databases, Active Storage uploads)
**/storage/*
!**/storage/.keep
*.sqlite3
*.sqlite3-*

# Secrets and local environment
.env*
!.env.example
**/config/master.key
**/config/credentials/*.key

# Assets and dependencies
**/public/assets/
**/node_modules/
node_modules/
**/vendor/bundle/
**/.bundle/
**/public/packs*
yarn-debug.log*
.yarn-integrity

# Test and coverage output
**/coverage/
**/spec/examples.txt

# Kamal
.kamal/secrets*
!.kamal/secrets.example
