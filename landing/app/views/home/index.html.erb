<% content_for :title, "azinger.io" %>
<main>
  <h1 class="logo">
    <span>azinger</span><b>.io</b>
  </h1>
  <p class="tag">Things we love.</p>
  <ul class="grid">
    <% [
        ["🤘","Rock on"],
        ["👨‍👩‍👧‍👦","Family"],
        ["🎸","Guitar"],
        ["⛳","Golf"],
        ["⚾","Baseball"],
        ["🎬","Film"],
        ["💻","Software"],
        ["🏐","Volleyball"],
        ["🎾","Tennis"],
        ["🐱","Cats"],
        ["📻","Radio"],
        ["📺","TV"],
        ["🍾","Champagne"],
        ["🍺","Beer"],
        ["🏃","Running"]
      ].each do |e, l| %>
      <li title="<%= l %>">
        <% if l == "Software" %>
          <%= link_to products_path, class: "grid-link", aria: { label: "Products" } do %><span aria-hidden="true"><%= e %></span><% end %>
        <% else %>
          <span role="img" aria-label="<%= l %>"><%= e %></span>
        <% end %>
      </li>
    <% end %>
  </ul>
</main>
<footer class="site-footer">
  <span>Version 2026.11.15.01</span>
  <span aria-hidden="true">::</span>
  <time datetime="2022-06-23">Established 6/23/22</time>
</footer>
